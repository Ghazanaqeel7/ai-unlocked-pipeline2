       "sub": "Say it differently",
       "glyph": "shuffle"
      },
      {
       "label": "Missing info",
       "sub": "Leave out a detail",
       "glyph": "help-circle"
      },
      {
       "label": "Two questions",
       "sub": "Ask both at once",
       "glyph": "layers"
      },
      {
       "label": "Typos",
       "sub": "Misspell on purpose",
       "glyph": "pen"
      },
      {
       "label": "Rude tone",
       "sub": "Test the guardrails",
       "glyph": "shield"
