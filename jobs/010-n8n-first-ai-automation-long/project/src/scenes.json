  {
   "id": "s32",
   "text": "You do not need ten nodes. You need one workflow that works from start to finish. A small automation that runs every day beats a giant one that never leaves your screen. Finish the loop first: message in, thought, tool call, answer out. Then, and only then, add the next idea on top of it.",
   "visual": [
    {
     "type": "hookcard",
     "theme": "obsidian",
     "text": "One workflow that works from start to finish",
     "accent": [
      "One"
     ]
    },
