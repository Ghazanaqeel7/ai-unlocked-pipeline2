       "text": "Open the node"
      },
      {
       "text": "Read the error"
      },
      {
       "text": "Check credentials"
      },
      {
       "text": "Check connections"
      },
      {
       "text": "Check empty fields"
      }
     ]
    },
    {
     "type": "hookcard",
     "theme": "obsidian",
     "text": "Fix one thing. Run it again.",
     "accent": [
      "one"
     ]
    }
   ]
  },
  {
   "id": "s29",
   "text": "One more habit before we make this run on its own.",
   "visual": [
    {
     "type": "hookcard",
     "theme": "studio",
     "text": "One more habit",
     "accent": [
      "habit"
     ]
    }
   ]
  },
  {
   "id": "s30",
   "text": "Change the question and run it again. Try five very different questions. If the answers stay useful across all five, your agent is ready. If one answer is wrong, fix the instructions, not the model.",
   "visual": [
    {
     "type": "interactiveuicard",
     "theme": "obsidian",
     "headline": "Change the question",
     "kind": "typing",
     "accent": [
      "five"
     ],
     "kicker": "HABIT",
     "query": "Try five very different questions",
     "typing": "Try five very different questions"
    },
    {
     "type": "perspectivewall",
     "theme": "sand",
     "headline": "Five Test Questions",
     "accent": [
      "Five"
     ],
     "kicker": "ONE BY ONE",
     "cards": [
      {
       "label": "Date math",
       "sub": "What is the date in 3 days?",
