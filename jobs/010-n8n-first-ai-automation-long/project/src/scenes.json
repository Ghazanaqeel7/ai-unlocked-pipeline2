  {
   "id": "s33",
   "text": "A chat workflow waits for you. To run on a clock, use the Schedule Trigger node. Pick seconds, minutes, hours, days, weeks or months, or type a custom cron expression. It uses the workflow's timezone if one is set, and otherwise the n8n instance timezone.",
   "visual": [
    {
     "type": "hookcard",
     "theme": "sand",
     "text": "Make it run on its own",
     "accent": [
      "own"
     ],
     "kicker": "CHAPTER 5"
    },
    {
     "type": "interactiveuicard",
     "theme": "studio",
     "headline": "Pick an interval",
     "kind": "dropdown",
     "accent": [
      "interval"
